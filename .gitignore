# Real secrets must never be committed - only examples/secrets.example.yaml.
# Patterns are anchored to the repo root (leading /) on purpose: an unanchored
# "secrets.yaml" also matches templates/secrets.yaml and would silently drop
# the chart's own Secret template out of git.
.env
.env.*
*.env
/secrets.yaml
/*-secrets.yaml
/*.secret.yaml
/*secrets.values.yaml
/*.local.yaml
!/templates/secrets.yaml

# Packaged charts
*.tgz
